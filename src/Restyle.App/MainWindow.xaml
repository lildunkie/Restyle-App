<Window x:Class="Restyle.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restyle" Icon="Assets/restyle.ico"
        Width="1080" Height="740" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="12,14,10,14">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,0,20">
                <Image Source="Assets/restyle.ico" Width="26" Height="26" />
                <TextBlock Text="Restyle" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Button x:Name="UndoButton" DockPanel.Dock="Bottom" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="12,8" Click="Undo_Click"
                    ToolTip="Puts back the settings from before your most recent change.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="Undo last change" />
                        <TextBlock x:Name="UndoLabel" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    </StackPanel>
                </StackPanel>
            </Button>

            <StackPanel>
                <RadioButton x:Name="NavPresets" Style="{StaticResource NavItem}" GroupName="Nav" Tag="presets" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Presets" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="customize" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Customize" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="dock" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Dock" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="backups" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE81C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="Backups" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="about" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <TextBlock Text="About" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- Page area -->
        <Border Grid.Column="1" CornerRadius="8,0,0,0" BorderThickness="1,1,0,0"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Message bar -->
                <Border x:Name="Banner" Visibility="Collapsed" Margin="24,16,24,0" CornerRadius="6" Padding="14,10"
                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Padding="8,4" Margin="8,0,0,0" VerticalAlignment="Top" Click="CloseBanner_Click" ToolTip="Dismiss" />
                        <Button x:Name="BannerAction" DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top"
                                Visibility="Collapsed" Click="BannerAction_Click" />
                        <TextBlock x:Name="BannerIcon" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                                   Margin="0,2,12,0" VerticalAlignment="Top" />
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
