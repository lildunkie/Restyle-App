<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Microsoft Store edition of Restyle. It compiles the same source as src/Restyle.App (so fixes
    apply to both) with STORE defined, and is packaged as an MSIX by store/build-msix.ps1.
    Store-only differences live behind "#if STORE" (startup task instead of the Run key, etc.).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>Restyle</AssemblyName>
    <RootNamespace>Restyle.App</RootNamespace>
    <DefineConstants>$(DefineConstants);STORE</DefineConstants>
    <ApplicationManifest>..\Restyle.App\app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Restyle.App\Assets\restyle.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- The package supplies its own files; don't pick up anything from this folder automatically. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
  </PropertyGroup>

  <PropertyGroup>
    <AppSource>..\Restyle.App\</AppSource>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Restyle.Core\Restyle.Core.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <!-- makeappx.exe / signtool.exe for building the .msix (downloaded only; nothing is linked into the app). -->
    <PackageDownload Include="Microsoft.Windows.SDK.BuildTools" Version="[10.0.28000.2526]" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Gen0Size" Value="0x100000" />
  </ItemGroup>

  <!-- Shared source from the main app -->
  <ItemGroup>
    <Compile Include="$(AppSource)**\*.cs" Exclude="$(AppSource)bin\**;$(AppSource)obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <ApplicationDefinition Include="$(AppSource)App.xaml" Link="App.xaml" />
    <Page Include="$(AppSource)**\*.xaml" Exclude="$(AppSource)App.xaml;$(AppSource)bin\**;$(AppSource)obj\**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <Resource Include="$(AppSource)Assets\restyle.ico" Link="Assets\restyle.ico" />
    <Content Include="$(AppSource)Presets\*.json" Link="Presets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="$(AppSource)Presets\*.json" LogicalName="Presets.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
